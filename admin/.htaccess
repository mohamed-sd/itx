# Allow larger uploads for hero background video (mod_php, no restart needed)
<IfModule php_module>
    php_value upload_max_filesize 64M
    php_value post_max_size 72M
    php_value max_execution_time 300
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 72M
    php_value max_execution_time 300
</IfModule>
